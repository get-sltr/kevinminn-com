---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Interstitial from '../components/Interstitial.astro';

export interface Props {
  title?: string;
  description?: string;
  activePage?: 'welcome' | 'sltr' | 'vindicara' | 'writing' | 'contact';
  noScroll?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title = 'Kevin Minn — Builder, writer, archivist of becoming.',
  description = 'Some of what I make is software. Some of it is sentences. All of it is for the parts of people the world forgets to keep.',
  activePage = 'welcome',
  noScroll = false,
  ogImage = '/assets/og.jpg',
  ogImageAlt = 'Front cover of Remember My Name, a memoir by Kevin Minn',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// Scrapers for LinkedIn and most mail clients refuse relative image paths.
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon. The .ico is there because browsers request /favicon.ico on their
         own, and because feed and preview tools still ignore SVG icons. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph. og:image is absolute and 1200x630, which is what LinkedIn
         and mail clients need before they will render a preview card. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kevin Minn" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Theme color (Cloudflare / mobile UI) -->
    <meta name="theme-color" content="#FBF8F3" />

    <!-- Preconnect to Google Fonts for the @import in global.css -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body class={noScroll ? 'no-scroll' : ''}>
    <Nav activePage={activePage} />

    <slot />

    <Interstitial />

    <script>
      (function () {
        const interstitial = document.getElementById('interstitial');
        if (!interstitial) return;

        const SEEN_KEY = 'kevinminn-interstitial-seen';
        const fill = interstitial.querySelector('[data-fill]') as HTMLElement | null;
        let pendingHref: string | null = null;
        let dismissTimer: ReturnType<typeof setTimeout> | null = null;
        let seenFallback = false;

        const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';

        const hasSeenInterstitial = () => {
          try {
            return window.localStorage.getItem(SEEN_KEY) === '1';
          } catch {
            return seenFallback;
          }
        };

        const markInterstitialSeen = () => {
          seenFallback = true;
          try {
            window.localStorage.setItem(SEEN_KEY, '1');
          } catch {
            /* localStorage can be unavailable in strict privacy modes. */
          }
        };

        const show = (href: string) => {
          markInterstitialSeen();
          pendingHref = href;
          interstitial.classList.add('is-active');
          if (fill) {
            fill.style.transition = 'none';
            fill.style.width = '0%';
            void fill.offsetWidth;
            fill.style.transition = 'width 4s linear';
            requestAnimationFrame(() => {
              fill.style.width = '100%';
            });
          }
          dismissTimer = setTimeout(dismiss, 4000);
        };

        const dismiss = () => {
          if (dismissTimer) clearTimeout(dismissTimer);
          interstitial.classList.remove('is-active');
          if (pendingHref) {
            setTimeout(() => {
              if (pendingHref) window.location.href = pendingHref;
            }, 500);
          }
        };

        document.querySelectorAll<HTMLAnchorElement>('[data-interstitial-link]').forEach((link) => {
          link.addEventListener('click', (e) => {
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            if (link.target && link.target !== '_self') return;

            const href = link.getAttribute('href');
            if (!href) return;

            const targetUrl = new URL(href, window.location.href);
            if (targetUrl.origin !== window.location.origin) return;
            if (
              normalizePath(targetUrl.pathname) === normalizePath(window.location.pathname) &&
              targetUrl.search === window.location.search &&
              targetUrl.hash === window.location.hash
            ) {
              return;
            }

            e.preventDefault();
            if (hasSeenInterstitial()) {
              window.location.href = targetUrl.href;
            } else {
              show(targetUrl.href);
            }
          });
        });

        interstitial.addEventListener('click', dismiss);
      })();
    </script>
  </body>
</html>
