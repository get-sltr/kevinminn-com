---
export const prerender = false;
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vault — Kevin Minn</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FBF8F3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="vault-body">
    <div class="vault">
      <header class="vault__header">
        <div class="vault__header-left">
          <h1 class="vault__title">Vault</h1>
          <nav class="vault__breadcrumb" id="breadcrumb"></nav>
        </div>
        <button class="vault__logout" id="logout-btn">Logout</button>
      </header>

      <div class="vault__actions">
        <button class="vault__btn vault__btn--secondary" id="new-folder-btn">+ New folder</button>
        <label class="vault__btn vault__btn--primary">
          Upload
          <input type="file" id="file-input" multiple hidden />
        </label>
        <div class="vault__search-wrap">
          <input type="text" class="vault__search" id="search-input" placeholder="Filter files..." />
        </div>
      </div>

      <div class="vault__dropzone" id="dropzone">
        <p>Drop files here to upload</p>
      </div>

      <div class="vault__split">
        <div class="vault__list" id="file-list">
          <p class="vault__empty">Loading...</p>
        </div>
        <aside class="vault__preview" id="preview">
          <p class="vault__preview-empty">Select a file to view it here.</p>
        </aside>
      </div>

      <div class="vault__modal" id="delete-modal">
        <div class="vault__modal-card">
          <p class="vault__modal-text" id="delete-text">Delete this item?</p>
          <div class="vault__modal-actions">
            <button class="vault__btn vault__btn--secondary" id="delete-cancel">Cancel</button>
            <button class="vault__btn vault__btn--danger" id="delete-confirm">Delete</button>
          </div>
        </div>
      </div>

      <div class="vault__upload-status" id="upload-status"></div>
    </div>

    <script>
      import { renderDocx } from '../../lib/vault/docx';

      let currentPrefix = '';
      let deleteTarget: { type: 'file' | 'folder'; key: string } | null = null;
      type VaultFile = { key: string; name: string; size: number; uploaded: string; contentType: string };
      let selectedKey: string | null = null;
      let currentFiles: VaultFile[] = [];
      let previewUrls: string[] = [];
      const previewEl = document.getElementById('preview')!;
      const listEl = document.getElementById('file-list')!;
      const breadcrumbEl = document.getElementById('breadcrumb')!;
      const searchEl = document.getElementById('search-input') as HTMLInputElement;
      const dropzone = document.getElementById('dropzone')!;
      const fileInput = document.getElementById('file-input') as HTMLInputElement;
      const modal = document.getElementById('delete-modal')!;
      const deleteText = document.getElementById('delete-text')!;
      const uploadStatus = document.getElementById('upload-status')!;

      function esc(s: string): string {
        return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
      }

      function formatSize(bytes: number): string {
        if (bytes === 0) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
      }

      function formatDate(iso: string): string {
        return new Date(iso).toLocaleDateString('en-US', {
          month: 'short', day: 'numeric', year: 'numeric',
        });
      }

      function fileIcon(file: VaultFile): string {
        const contentType = file.contentType;
        const kind = previewKind(file);
        if (kind === 'image') return '\u{1F5BC}';
        if (kind === 'pdf' || kind === 'text') return '\u{1F4C4}';
        if (kind === 'docx') return '\u{1F4DD}';
        if (kind === 'video') return '\u{1F3AC}';
        if (kind === 'audio') return '\u{1F3B5}';
        if (contentType.includes('spreadsheet') || contentType.includes('excel')) return '\u{1F4CA}';
        if (contentType.includes('zip') || contentType.includes('compressed')) return '\u{1F4E6}';
        return '\u{1F4CE}';
      }

      function updateBreadcrumb() {
        const parts = currentPrefix.split('/').filter(Boolean);
        let html = '<button class="vault__crumb" data-prefix="">Root</button>';
        let acc = '';
        for (const part of parts) {
          acc += part + '/';
          html += ` <span class="vault__crumb-sep">/</span> <button class="vault__crumb" data-prefix="${esc(acc)}">${esc(part)}</button>`;
        }
        breadcrumbEl.innerHTML = html;
        breadcrumbEl.querySelectorAll<HTMLButtonElement>('.vault__crumb').forEach((btn) => {
          btn.addEventListener('click', () => {
            currentPrefix = btn.dataset.prefix || '';
            loadFiles();
          });
        });
      }

      async function loadFiles() {
        updateBreadcrumb();
        const res = await fetch(`/api/vault/list?prefix=${encodeURIComponent(currentPrefix)}`);
        const data = await res.json();
        renderList(data.folders, data.files);
      }

      function renderList(folders: Array<{name: string; prefix: string}>, files: VaultFile[]) {
        currentFiles = files;
        const query = searchEl.value.toLowerCase();
        let html = '';

        for (const folder of folders) {
          if (query && !folder.name.toLowerCase().includes(query)) continue;
          html += `<div class="vault__row vault__row--folder" data-prefix="${esc(folder.prefix)}">
            <span class="vault__row-icon">\u{1F4C1}</span>
            <span class="vault__row-name">${esc(folder.name)}</span>
            <span class="vault__row-meta"></span>
            <div class="vault__row-actions">
              <button class="vault__row-btn vault__row-btn--del" data-delete-folder="${esc(folder.prefix)}" title="Delete folder">Delete</button>
            </div>
          </div>`;
        }

        for (const file of files) {
          if (query && !file.name.toLowerCase().includes(query)) continue;
          const selected = file.key === selectedKey ? ' is-selected' : '';
          html += `<button type="button" class="vault__row vault__row--file${selected}" data-select="${esc(file.key)}">
            <span class="vault__row-icon">${fileIcon(file)}</span>
            <span class="vault__row-text">
              <span class="vault__row-name">${esc(file.name)}</span>
              <span class="vault__row-meta">${formatSize(file.size)} &middot; ${formatDate(file.uploaded)}</span>
            </span>
          </button>`;
        }

        if (!html) {
          html = '<p class="vault__empty">No files yet. Upload something or create a folder.</p>';
        }

        listEl.innerHTML = html;

        listEl.querySelectorAll<HTMLDivElement>('.vault__row--folder').forEach((row) => {
          row.addEventListener('click', (e) => {
            if ((e.target as HTMLElement).closest('.vault__row-btn')) return;
            currentPrefix = row.dataset.prefix || '';
            searchEl.value = '';
            loadFiles();
          });
        });

        listEl.querySelectorAll<HTMLButtonElement>('[data-select]').forEach((row) => {
          row.addEventListener('click', () => {
            const file = currentFiles.find((f) => f.key === row.dataset.select);
            if (file) showPreview(file);
          });
        });

        listEl.querySelectorAll<HTMLButtonElement>('[data-delete-folder]').forEach((btn) => {
          btn.addEventListener('click', () => {
            deleteTarget = { type: 'folder', key: btn.dataset.deleteFolder! };
            const name = btn.dataset.deleteFolder!.replace(/\/$/, '').split('/').pop();
            deleteText.textContent = `Delete folder "${name}"? It must be empty.`;
            modal.classList.add('is-open');
          });
        });
      }

      type PreviewKind = 'image' | 'pdf' | 'video' | 'audio' | 'text' | 'docx' | 'none';
      const TEXT_EXTS = ['txt', 'md', 'csv', 'json', 'log', 'yml', 'yaml', 'xml', 'tsv'];
      const TEXT_LIMIT = 2 * 1024 * 1024;
      const DOCX_LIMIT = 25 * 1024 * 1024;

      function previewKind(file: VaultFile): PreviewKind {
        const t = file.contentType;
        const ext = file.name.includes('.') ? file.name.split('.').pop()!.toLowerCase() : '';
        if (t.startsWith('image/') || ['png', 'jpg', 'jpeg', 'gif', 'webp', 'avif', 'svg', 'heic'].includes(ext)) return 'image';
        if (t === 'application/pdf' || ext === 'pdf') return 'pdf';
        if (t.startsWith('video/') || ['mp4', 'mov', 'webm', 'm4v'].includes(ext)) return 'video';
        if (t.startsWith('audio/') || ['mp3', 'm4a', 'wav', 'aac', 'ogg'].includes(ext)) return 'audio';
        if (t.startsWith('text/') || t === 'application/json' || TEXT_EXTS.includes(ext)) return 'text';
        if (t === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' || ext === 'docx') return 'docx';
        return 'none';
      }

      function noPreview(body: HTMLElement, href: string, reason: string) {
        body.innerHTML = `<div class="vault__preview-none">
          <p>${esc(reason)}</p>
          <a class="vault__btn vault__btn--primary" href="${href}">Download to open</a>
        </div>`;
      }

      function releasePreviewUrls() {
        previewUrls.forEach((url) => URL.revokeObjectURL(url));
        previewUrls = [];
      }

      async function showPreview(file: VaultFile) {
        selectedKey = file.key;
        releasePreviewUrls();
        listEl.querySelectorAll<HTMLElement>('[data-select]').forEach((row) => {
          row.classList.toggle('is-selected', row.dataset.select === file.key);
        });

        const src = `/api/vault/download?key=${encodeURIComponent(file.key)}`;
        const kind = previewKind(file);
        previewEl.innerHTML = `<div class="vault__preview-head">
            <div class="vault__preview-title">
              <h2 class="vault__preview-name">${esc(file.name)}</h2>
              <p class="vault__preview-meta">${formatSize(file.size)} &middot; ${formatDate(file.uploaded)}</p>
            </div>
            <div class="vault__preview-actions">
              ${kind === 'pdf' ? `<a class="vault__row-btn" href="${src}&inline=1" target="_blank" rel="noopener">Open in tab</a>` : ''}
              <a class="vault__row-btn" href="${src}">Download</a>
              <button type="button" class="vault__row-btn vault__row-btn--del" id="preview-delete">Delete</button>
            </div>
          </div>
          <div class="vault__preview-body" id="preview-body"></div>`;

        document.getElementById('preview-delete')!.addEventListener('click', () => {
          deleteTarget = { type: 'file', key: file.key };
          deleteText.textContent = `Delete "${file.name}"?`;
          modal.classList.add('is-open');
        });

        const body = document.getElementById('preview-body')!;
        if (kind === 'image') {
          const img = document.createElement('img');
          img.className = 'vault__preview-img';
          img.alt = file.name;
          img.src = src;
          img.addEventListener('error', () => noPreview(body, src, 'This browser cannot display this image.'));
          body.appendChild(img);
        } else if (kind === 'pdf') {
          body.innerHTML = `<iframe class="vault__preview-frame" src="${src}&inline=1" title="${esc(file.name)}"></iframe>`;
        } else if (kind === 'video' || kind === 'audio') {
          const media = document.createElement(kind);
          media.className = `vault__preview-${kind}`;
          media.controls = true;
          media.src = src;
          media.addEventListener('error', () => noPreview(body, src, 'This browser cannot play this file.'));
          body.appendChild(media);
        } else if (kind === 'text') {
          if (file.size > TEXT_LIMIT) {
            noPreview(body, src, 'This file is too large to preview.');
          } else {
            body.innerHTML = '<p class="vault__preview-empty">Loading...</p>';
            const res = await fetch(src);
            if (selectedKey !== file.key) return;
            const pre = document.createElement('pre');
            pre.className = 'vault__preview-text';
            pre.textContent = res.ok ? await res.text() : 'Could not load this file.';
            body.replaceChildren(pre);
          }
        } else if (kind === 'docx') {
          if (file.size > DOCX_LIMIT) {
            noPreview(body, src, 'This document is too large to preview.');
          } else {
            body.innerHTML = '<p class="vault__preview-empty">Loading...</p>';
            try {
              const res = await fetch(src);
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              const doc = await renderDocx(await res.arrayBuffer());
              if (selectedKey !== file.key) {
                doc.urls.forEach((url) => URL.revokeObjectURL(url));
                return;
              }
              previewUrls = doc.urls;
              const note = document.createElement('p');
              note.className = 'vault__docx-note';
              note.textContent = 'Simplified preview. Download for exact formatting.';
              doc.node.prepend(note);
              body.replaceChildren(doc.node);
            } catch {
              if (selectedKey === file.key) noPreview(body, src, 'This document could not be previewed.');
            }
          }
        } else {
          noPreview(body, src, 'No preview for this file type.');
        }

        if (window.matchMedia('(max-width: 900px)').matches) {
          previewEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      function clearPreview() {
        selectedKey = null;
        releasePreviewUrls();
        previewEl.innerHTML = '<p class="vault__preview-empty">Select a file to view it here.</p>';
      }

      async function uploadFiles(files: FileList | File[]) {
        for (const file of Array.from(files)) {
          uploadStatus.textContent = `Uploading ${file.name}...`;
          uploadStatus.classList.add('is-visible');
          const form = new FormData();
          form.append('file', file);
          form.append('folder', currentPrefix);
          const res = await fetch('/api/vault/upload', { method: 'POST', body: form });
          if (!res.ok) {
            uploadStatus.textContent = `Failed to upload ${file.name}`;
            setTimeout(() => uploadStatus.classList.remove('is-visible'), 3000);
            return;
          }
        }
        uploadStatus.textContent = 'Upload complete.';
        setTimeout(() => uploadStatus.classList.remove('is-visible'), 2000);
        loadFiles();
      }

      fileInput.addEventListener('change', () => {
        if (fileInput.files?.length) uploadFiles(fileInput.files);
        fileInput.value = '';
      });

      dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('is-drag'); });
      dropzone.addEventListener('dragleave', () => dropzone.classList.remove('is-drag'));
      dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('is-drag');
        if (e.dataTransfer?.files.length) uploadFiles(e.dataTransfer.files);
      });

      searchEl.addEventListener('input', () => loadFiles());

      document.getElementById('new-folder-btn')!.addEventListener('click', () => {
        const name = prompt('Folder name:');
        if (!name) return;
        fetch('/api/vault/folder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ parent: currentPrefix, name }),
        }).then(() => loadFiles());
      });

      document.getElementById('delete-cancel')!.addEventListener('click', () => {
        modal.classList.remove('is-open');
        deleteTarget = null;
      });

      document.getElementById('delete-confirm')!.addEventListener('click', async () => {
        if (!deleteTarget) return;
        if (deleteTarget.type === 'file') {
          await fetch(`/api/vault/delete?key=${encodeURIComponent(deleteTarget.key)}`, { method: 'DELETE' });
          if (deleteTarget.key === selectedKey) clearPreview();
        } else {
          const res = await fetch(`/api/vault/folder?prefix=${encodeURIComponent(deleteTarget.key)}`, { method: 'DELETE' });
          if (!res.ok) {
            const data = await res.json();
            alert(data.error || 'Could not delete folder.');
          }
        }
        modal.classList.remove('is-open');
        deleteTarget = null;
        loadFiles();
      });

      document.getElementById('logout-btn')!.addEventListener('click', async () => {
        await fetch('/api/vault/logout', { method: 'POST' });
        window.location.href = '/vault/login';
      });

      loadFiles();
    </script>

    <!-- Global because the rows are built by the script above via innerHTML, which never
         receives Astro's scoping attribute. Every class here is vault__ prefixed. -->
    <style is:global>
      .vault-body {
        background: #fbf8f3;
        min-height: 100vh;
      }
      .vault {
        max-width: 1280px;
        margin: 0 auto;
        padding: 32px 40px;
      }
      .vault__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e8e1d2;
      }
      .vault__header-left {
        display: flex;
        align-items: baseline;
        gap: 16px;
        flex-wrap: wrap;
      }
      .vault__title {
        font-family: 'Fraunces', serif;
        font-weight: 300;
        font-size: 32px;
        color: #1c1a17;
        letter-spacing: -0.02em;
      }
      .vault__breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
      }
      .vault__crumb {
        background: none;
        border: none;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #4a453d;
        padding: 0;
        transition: color 0.15s;
      }
      .vault__crumb:hover { color: #b4543e; }
      .vault__crumb-sep {
        font-size: 12px;
        color: #8a8479;
      }
      .vault__logout {
        background: none;
        border: 1px solid #e8e1d2;
        padding: 8px 16px;
        border-radius: 999px;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 500;
        color: #4a453d;
        cursor: pointer;
        transition: border-color 0.2s, color 0.2s;
      }
      .vault__logout:hover { border-color: #1c1a17; color: #1c1a17; }
      .vault__actions {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
        flex-wrap: wrap;
      }
      .vault__btn {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 500;
        padding: 10px 16px;
        border-radius: 999px;
        cursor: pointer;
        border: none;
        transition: all 0.2s;
      }
      .vault__btn--primary {
        background: #1c1a17;
        color: #fbf8f3;
      }
      .vault__btn--primary:hover { background: #b4543e; }
      .vault__btn--secondary {
        background: transparent;
        border: 1px solid #e8e1d2;
        color: #1c1a17;
      }
      .vault__btn--secondary:hover { border-color: #1c1a17; }
      .vault__btn--danger {
        background: #b4543e;
        color: #fbf8f3;
      }
      .vault__btn--danger:hover { background: #8b3a29; }
      .vault__search-wrap { flex: 1; min-width: 160px; }
      .vault__search {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #e8e1d2;
        background: #f4efe6;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #1c1a17;
        border-radius: 999px;
        outline: none;
      }
      .vault__search:focus { border-color: #b4543e; }
      .vault__search::placeholder { color: #8a8479; }
      .vault__dropzone {
        border: 2px dashed #e8e1d2;
        border-radius: 4px;
        padding: 20px;
        text-align: center;
        margin-bottom: 16px;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #8a8479;
        transition: border-color 0.2s, background 0.2s;
      }
      .vault__dropzone.is-drag {
        border-color: #b4543e;
        background: rgba(180, 84, 62, 0.04);
      }
      .vault__split {
        display: grid;
        grid-template-columns: minmax(280px, 380px) 1fr;
        gap: 24px;
        align-items: start;
      }
      .vault__list {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .vault__row--file {
        grid-template-columns: 28px 1fr;
        width: 100%;
        background: none;
        border: none;
        border-bottom: 1px solid #e8e1d2;
        text-align: left;
        cursor: pointer;
        font: inherit;
      }
      .vault__row--file.is-selected {
        background: #f4efe6;
        box-shadow: inset 2px 0 0 #b4543e;
      }
      .vault__row-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
      }
      .vault__preview {
        position: sticky;
        top: 24px;
        height: calc(100vh - 48px);
        display: flex;
        flex-direction: column;
        border: 1px solid #e8e1d2;
        border-radius: 4px;
        background: #fff;
        min-width: 0;
        overflow: hidden;
      }
      .vault__preview-empty {
        margin: auto;
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-size: 16px;
        color: #8a8479;
        padding: 24px;
        text-align: center;
      }
      .vault__preview-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 20px;
        border-bottom: 1px solid #e8e1d2;
        background: #fbf8f3;
      }
      .vault__preview-title { min-width: 0; }
      .vault__preview-name {
        font-family: 'Inter', sans-serif;
        font-size: 15px;
        font-weight: 500;
        color: #1c1a17;
        overflow-wrap: anywhere;
      }
      .vault__preview-meta {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        color: #8a8479;
        margin-top: 2px;
      }
      .vault__preview-actions {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
        flex-wrap: wrap;
        justify-content: flex-end;
      }
      .vault__preview-body {
        flex: 1;
        min-height: 0;
        display: flex;
        overflow: auto;
      }
      .vault__preview-img,
      .vault__preview-video {
        margin: auto;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        padding: 16px;
      }
      .vault__preview-audio { margin: auto; width: 90%; }
      .vault__preview-frame {
        flex: 1;
        width: 100%;
        border: 0;
      }
      .vault__preview-text {
        flex: 1;
        margin: 0;
        padding: 20px;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 13px;
        line-height: 1.55;
        color: #1c1a17;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
      .vault__docx {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        align-self: flex-start;
        padding: 28px 40px 48px;
        font-family: 'Inter', sans-serif;
        font-size: 15px;
        line-height: 1.65;
        color: #1c1a17;
        tab-size: 4;
      }
      .vault__docx-note {
        font-size: 12px;
        color: #8a8479;
        padding-bottom: 12px;
        margin-bottom: 24px;
        border-bottom: 1px solid #e8e1d2;
      }
      .vault__docx p,
      .vault__docx h1,
      .vault__docx h2,
      .vault__docx h3,
      .vault__docx h4,
      .vault__docx h5,
      .vault__docx h6 {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
      .vault__docx p { margin: 0 0 0.6em; }
      .vault__docx h1,
