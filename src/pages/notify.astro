---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { CONSENT_TEXT } from '../lib/consent';
---

<Base
  activePage="writing"
  title="Get the release date for Remember My Name"
  description="Hear first when Remember My Name, a memoir by Kevin Minn, has a release date."
>
  <main class="page">
    <div class="inner">
      <img class="cover" src="/assets/bookcover6.png" alt="Front cover of Remember My Name" />

      <div class="eyebrow">Releasing this fall</div>
      <h1>Remember <em>My Name.</em></h1>
      <div class="lede">
        <p>He learned to survive by making himself smaller.</p>
        <p>
          Leaving Burma gave him the chance to become someone else, until the life he built at
          thirty-five thousand feet forced him to choose between losing everything and finally
          living in the open.
        </p>
      </div>

      <div class="box">
        <p class="lh">Hear the release date first.</p>
        <p class="lp">One letter when there is news. No funnel, no spam, no other plans.</p>

        <form id="notify-form" novalidate>
          <label class="sr-only" for="notify-email">Email address</label>
          <input
            id="notify-email"
            name="email"
            type="email"
            placeholder="your@email.com"
            autocomplete="email"
            required
          />
          <div class="hp" aria-hidden="true">
            <label for="notify-website">Leave this field empty</label>
            <input id="notify-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit">Notify me</button>
        </form>

        <p class="status" id="notify-status" role="status" aria-live="polite"></p>
        <p class="fine">{CONSENT_TEXT}</p>
      </div>

      <a href="/writing" class="back">&larr; Back to the writing</a>
    </div>
  </main>

  <Footer />
</Base>

<style>
  :global(body) {
    background: #f4efe6;
  }
  /* Nav sits over a light surface here, so the brand mark needs dark ink. */
  :global(.nav-top__mark) {
    color: #1c1a17;
    text-shadow: none;
  }
  :global(.nav-top__mark em) {
    color: #b4543e;
  }

  .page {
    padding: 120px 40px 90px;
  }
  .inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .cover {
    display: block;
    width: 190px;
    height: auto;
    margin: 0 auto 36px;
    border-radius: 2px;
    border: 1px solid #e8e1d2;
    box-shadow:
      0 1px 3px rgba(28, 26, 23, 0.16),
      0 14px 32px rgba(28, 26, 23, 0.16);
  }

  .eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: #b4543e;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  h1 {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: clamp(34px, 5vw, 50px);
    color: #1c1a17;
    letter-spacing: -0.025em;
    line-height: 1;
    margin-bottom: 20px;
  }
  h1 em {
    font-style: italic;
    font-weight: 400;
    color: #b4543e;
  }

  .lede {
    margin-bottom: 40px;
  }
  .lede p {
    text-wrap: pretty;
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: 19px;
    line-height: 1.55;
    color: #1c1a17;
  }
  .lede p + p {
    margin-top: 14px;
  }

  .box {
    background: #fbf8f3;
    border: 1px solid #e8e1d2;
    border-radius: 4px;
    padding: 34px 30px 28px;
    text-align: left;
  }
  .lh {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    color: #1c1a17;
    margin-bottom: 6px;
  }
  .lp {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #8a8479;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  form {
    display: flex;
    gap: 10px;
  }
  input[type='email'] {
    flex: 1;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #1c1a17;
    background: #fbf8f3;
    border: 1px solid #e8e1d2;
    border-radius: 2px;
    padding: 12px 14px;
    outline: none;
  }
  input[type='email']:focus {
    border-color: #b4543e;
  }
  input[type='email']::placeholder {
    color: #8a8479;
  }
  button {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #fbf8f3;
    background: #b4543e;
    border: none;
    border-radius: 2px;
    padding: 12px 22px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  button:hover {
    background: #9c4634;
  }
  button[disabled] {
    opacity: 0.6;
    cursor: default;
  }

  /* Honeypot. Off-screen rather than display:none, which bots skip. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .status {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 15px;
    color: #4a453d;
    min-height: 22px;
    margin-top: 14px;
  }
  .status.is-error {
    color: #b4543e;
    font-style: normal;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
  }

  .fine {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    line-height: 1.7;
    color: #8a8479;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid #e8e1d2;
  }

  .back {
    display: inline-block;
    margin-top: 40px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #8a8479;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back:hover {
    color: #b4543e;
  }

  @media (max-width: 560px) {
    .page {
      padding: 100px 22px 70px;
    }
    form {
      flex-direction: column;
    }
  }
</style>

<script>
  const form = document.getElementById('notify-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('notify-status');

  if (form && statusEl) {
    const button = form.querySelector('button') as HTMLButtonElement | null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const website = String(data.get('website') ?? '');

      statusEl.classList.remove('is-error');

      if (!email) {
        statusEl.textContent = 'Enter an email address.';
        statusEl.classList.add('is-error');
        return;
      }

      if (button) button.disabled = true;
      statusEl.textContent = 'Signing you up...';

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website }),
        });
        const body = (await res.json()) as { ok?: boolean; error?: string };

        if (res.ok && body.ok) {
          form.hidden = true;
          statusEl.textContent = 'Thank you. You will hear from me when the date is set.';
        } else {
          statusEl.textContent = body.error || 'Something went wrong. Please try again.';
          statusEl.classList.add('is-error');
          if (button) button.disabled = false;
        }
      } catch {
        statusEl.textContent = 'Could not reach the server. Please try again.';
        statusEl.classList.add('is-error');
        if (button) button.disabled = false;
      }
    });
  }
</script>
