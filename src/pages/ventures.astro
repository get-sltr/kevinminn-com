---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const studioApps = [
  {
    name: 'Primal',
    status: 'Web app',
    image: '/assets/ventures/primal-logo.png',
    alt: 'Primal product mark',
    copy:
      'A private social web app for gay men, built around direct connection, discovery, and intent.',
  },
  {
    name: 'MemoryAisle',
    status: 'App Store',
    image: '/assets/ventures/memoryaisle-logo.png',
    alt: 'MemoryAisle product mark',
    href: 'https://apps.apple.com/us/app/memoryaisle-glp-1-nutrition/id6761938171',
    hrefLabel: 'View on App Store',
    copy:
      'A GLP-1 nutrition coach for steadier meals, clearer tracking, and support that fits real life.',
  },
  {
    name: 'DriftLab HQ',
    status: 'Beta soon',
    image: '/assets/ventures/driftlab-logo.png',
    alt: 'DriftLab HQ product mark',
    copy:
      'A calm operating space for ideas, notes, projects, and systems. Built for people who need one place to think clearly, shape work, and keep momentum visible.',
    signup: true,
  },
];

const vindicaraProjects = [
  {
    name: 'PROJECT',
    highlight: 'AIR',
    status: 'Agent accountability',
    image: '/assets/ventures/project-air-logo.png',
    alt: 'Project AIR aircraft logo',
    href: 'https://vindicara.io/get-started/',
    hrefLabel: 'Start with Project AIR',
    copy:
      'Project AIR is the answer: an evidence layer for AI agents that monitors sensitive actions, enforces human authority, and creates a signed, court-supportable record. No agent is autonomous. Every action traces back to a named human. Every agent action, proven.',
  },
  {
    name: 'AXIISIUM',
    status: 'Oncology AI',
    image: '/assets/ventures/axiisium-logo.png',
    alt: 'AXIISIUM healthcare AI logo',
    copy:
      'Axiisium is early-stage multimodal AI for acute myeloid leukemia, built to read pathology, flow, genetics, and clinical signals together. Its first job is trial enrichment: helping sponsors prioritize who to sequence first, move faster with fewer screening tests, and keep every selection tied to a signed, independently verifiable record. Read the whole patient. Prove every call.',
    fineNote: 'Axiisium is early and in active development.',
  },
];
---

<Base
  activePage="ventures"
  title="Ventures - Kevin Minn"
  description="Independent apps through SLTR Digital Studio and healthcare security software through Vindicara."
>
  <main class="page">
    <section class="hero">
      <div class="eyebrow">Ventures</div>
      <h1>The <em>work.</em></h1>
      <p class="lede">
        Two lanes of work: independent apps through SLTR Digital Studio, and healthcare security
        software through Vindicara.
      </p>
    </section>

    <section class="venture-section" aria-labelledby="sltr-heading">
      <div class="section-kicker">Independent apps</div>
      <div class="section-heading">
        <h2 id="sltr-heading">SLTR Digital Studio</h2>
        <p>
          Small, focused products built for people whose everyday needs are often overlooked by
          generic software.
        </p>
      </div>

      <div class="app-grid">
        {
          studioApps.map((app) => (
            <article class="app-card">
              <div class="app-mark">
                <img src={app.image} alt={app.alt} loading="lazy" />
              </div>
              <div class="app-copy">
                <div class="app-meta">{app.status}</div>
                <h3>{app.name}</h3>
                <p>{app.copy}</p>
                {
                  app.href && (
                    <a href={app.href} class="app-link" target="_blank" rel="noopener noreferrer">
                      {app.hrefLabel}
                    </a>
                  )
                }
                {
                  app.signup && (
                    <form class="signup-form" id="driftlab-signup">
                      <label class="sr-only" for="driftlab-email">
                        Email for DriftLab HQ beta signup
                      </label>
                      <input
                        id="driftlab-email"
                        name="email"
                        type="email"
                        placeholder="your@email.com"
                        autocomplete="email"
                        required
                      />
                      <button type="submit">Join beta</button>
                    </form>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="venture-section vindicara" aria-labelledby="vindicara-heading">
      <div class="section-kicker">Company</div>
      <div class="section-heading">
        <h2 id="vindicara-heading">Vindicara</h2>
        <p>
          Vindicara builds the system of record for human accountability over AI agents. It began
          as a runtime security engine for policy enforcement, tool scanning, agent identity, drift
          detection, and compliance evidence. That work revealed the sharper question: when an
          agent acts, can you prove what it did and who authorized it?
        </p>
        <a href="https://vindicara.io/" class="section-link" target="_blank" rel="noopener noreferrer">
          Visit Vindicara
        </a>
      </div>

      <div class="product-label">Vindicara products</div>
      <div class="project-stack">
        {
          vindicaraProjects.map((project) => (
            <article class:list={['project-card', project.image && 'project-card--featured']}>
              {
                project.image && (
                  <div class="project-visual">
                    <img src={project.image} alt={project.alt} loading="lazy" />
                  </div>
                )
              }
              <div class="project-copy">
                <div class="app-meta">{project.status}</div>
                <h3>
                  {project.name}{' '}
                  {project.highlight && <span class="air-red">{project.highlight}</span>}
                </h3>
                <p>{project.copy}</p>
                {project.fineNote && <p class="fine-note">{project.fineNote}</p>}
                {
                  project.href && (
                    <a href={project.href} class="app-link" target="_blank" rel="noopener noreferrer">
                      {project.hrefLabel}
                    </a>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <a href="/" class="back" data-interstitial-link>&larr; Back to welcome</a>
    <Footer />
  </main>
</Base>

<script>
  const driftForm = document.getElementById('driftlab-signup');
  driftForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(driftForm);
    const email = String(data.get('email') ?? '').trim();
    const subject = encodeURIComponent('DriftLab HQ beta signup');
    const body = encodeURIComponent(
      `Email: ${email}\n\nI would like early access to DriftLab HQ.`
    );
    window.location.href = `mailto:hello@kevinminn.com?subject=${subject}&body=${body}`;
  });
</script>

<style>
  .sr-only {
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    position: absolute;
  }
  .page {
    padding: 140px 80px 40px;
    min-height: 100vh;
  }
  .hero {
    max-width: 760px;
    margin-bottom: 88px;
  }
  .eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.24em;
    color: #b4543e;
    margin-bottom: 28px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: #b4543e;
  }
  h1 {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: clamp(48px, 6vw, 88px);
    line-height: 1;
    letter-spacing: -0.035em;
    color: #1c1a17;
    margin-bottom: 32px;
  }
  h1 em {
    font-style: italic;
    font-weight: 400;
    color: #b4543e;
  }
  .lede {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: clamp(18px, 1.4vw, 21px);
    line-height: 1.55;
    color: #4a453d;
    max-width: 620px;
  }
  .venture-section {
    border-top: 1px solid #e8e1d2;
    padding: 48px 0 72px;
  }
  .vindicara {
    min-height: 100vh;
    padding-top: 96px;
    margin-top: 120px;
  }
  .section-kicker,
  .app-meta {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .section-kicker {
    color: #b4543e;
    margin-bottom: 18px;
  }
  .section-heading {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(280px, 1fr);
    gap: 64px;
    align-items: start;
    margin-bottom: 34px;
  }
  .vindicara .section-heading {
    grid-template-columns: minmax(260px, 0.7fr) minmax(360px, 1fr);
    padding: 40px 0 48px;
    border-top: 1px solid #1c1a17;
    border-bottom: 1px solid #e8e1d2;
  }
  .vindicara h2 {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  h2 {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 1.05;
    color: #1c1a17;
    letter-spacing: -0.03em;
  }
  .section-heading p,
  .app-copy p,
  .project-copy p {
    color: #4a453d;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.75;
  }
  .app-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: #e8e1d2;
    border: 1px solid #e8e1d2;
  }
  .app-card {
    background: #fbf8f3;
    min-height: 100%;
  }
  .app-mark {
    aspect-ratio: 1;
    background: #f4efe6;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .app-mark img {
    width: 52%;
    height: 52%;
    object-fit: contain;
  }
  .app-copy,
  .project-copy {
    padding: 28px;
  }
  .app-meta {
    color: #8a8479;
    margin-bottom: 14px;
  }
  h3 {
    font-family: 'Fraunces', serif;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.1;
    color: #1c1a17;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  .app-link {
    display: inline-flex;
    margin-top: 18px;
    color: #b4543e;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }
  .app-link:hover {
    color: #1c1a17;
  }
  .section-link {
    display: inline-flex;
    margin-top: 18px;
    color: #b4543e;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }
  .section-link:hover {
    color: #1c1a17;
  }
  .signup-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    margin-top: 22px;
  }
  .signup-form input,
  .signup-form button {
    height: 42px;
    border: 1px solid #e8e1d2;
    background: #fbf8f3;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
  }
  .signup-form input {
    min-width: 0;
    padding: 0 12px;
    color: #1c1a17;
  }
  .signup-form button {
    padding: 0 16px;
    color: #fbf8f3;
    background: #1c1a17;
    border-color: #1c1a17;
    cursor: pointer;
  }
  .signup-form button:hover {
    background: #b4543e;
    border-color: #b4543e;
  }
  .project-stack {
    display: grid;
    gap: 16px;
  }
  .product-label {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8a8479;
    margin: 44px 0 16px;
  }
  .project-card {
    border: 1px solid #e8e1d2;
    background: #fbf8f3;
  }
  .project-card--featured {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) minmax(320px, 1fr);
    align-items: stretch;
  }
  .project-visual {
    background: transparent;
    min-height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .project-visual img {
    width: 28%;
    height: 28%;
    object-fit: contain;
  }
  .project-card h3 {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .project-copy .fine-note {
    margin-top: 16px;
    color: #8a8479;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    line-height: 1.6;
  }
  .air-red {
    color: #e63946;
    font-style: normal;
  }
  .back {
    display: inline-flex;
    margin-top: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #4a453d;
    text-decoration: none;
    transition: color 0.2s;
  }
  .back:hover {
    color: #b4543e;
  }
  @media (max-width: 980px) {
    .page {
      padding: 100px 32px 32px;
    }
    .section-heading,
    .project-card--featured {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .app-grid {
      grid-template-columns: 1fr;
    }
    .project-visual {
      min-height: 220px;
    }
  }
  @media (max-width: 768px) {
    .page {
      padding: 88px 20px 24px;
    }
    .hero {
      margin-bottom: 64px;
    }
    h1 {
      font-size: clamp(36px, 10vw, 56px);
    }
    .lede {
      font-size: 16px;
    }
    .venture-section {
      padding: 40px 0 56px;
    }
    .app-copy,
    .project-copy {
      padding: 22px;
    }
    h3 {
      font-size: 26px;
    }
    .signup-form {
      grid-template-columns: 1fr;
    }
  }
</style>
