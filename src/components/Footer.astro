---
const year = new Date().getFullYear();

// Every href here must point somewhere real. A previous list sent LinkedIn to a
// different Kevin Minn, and GitHub to an account that 404s.
const social = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/kevin-minn' },
  { label: 'Instagram', href: 'https://www.instagram.com/kevbuilds.ai' },
  { label: 'Facebook', href: 'https://www.facebook.com/kevinminn' },
  { label: 'Email', href: 'mailto:info@kevinminn.com' },
];
---

<footer class="foot">
  <div class="foot__left">
    <span>&copy; {year} Kevin Minn</span>
    <span class="foot__dot" id="foot-dot" aria-hidden="true"></span>
    <span class="foot__signed">made in Los Angeles</span>
  </div>
  <div class="foot__social">
    {
      social.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={s.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
        >
          {s.label}
        </a>
      ))
    }
  </div>
</footer>

<script>
  // Private way into the vault: triple-tap the footer dot inside 1.2s.
  // Deliberately not a link, so nothing crawlable ever points at /vault. The
  // login has no rate limiting, so the URL staying undiscovered is doing real
  // security work. A triple tap is hard to trigger by accident.
  const dot = document.getElementById('foot-dot');
  if (dot) {
    let taps = 0;
    let timer: ReturnType<typeof setTimeout> | null = null;

    dot.addEventListener('click', () => {
      taps += 1;
      if (timer) clearTimeout(timer);

      if (taps >= 3) {
        taps = 0;
        window.location.href = '/vault';
        return;
      }

      timer = setTimeout(() => {
        taps = 0;
      }, 1200);
    });
  }
</script>
